    "suggest": {
        "ext-dom": "Para procesar documentos XML",
        "ext-simplexml": "Para leer y modificar XML",
        "ext-gd": "Para generar códigos QR en PNG",
        "ext-openssl": "Para firmar y procesar certificados",
        "ext-xsl": "Para generar la cadena original con XSLT"
